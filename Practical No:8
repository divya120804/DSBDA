PRACTICAL NO:8:Titanic dataset exploration & fare distribution using histogram
import seaborn as sns
import matplotlib.pyplot as plt
titanic=sns.load_dataset(‘titanic’)
titanic.head()
titanic.info()
sns.countplot(x=’survived’,data=titanic)
plt.title(“Survival Count”)
plt.show()
sns.countplot(x=’sex’,hue=’survived’,data=titanic)
plt.tilte(“Survival by Gender”)
plt.show()
sns.countplot(x=’pclass’,hue=’survived’data=titanic)
plt.titanic(“Survival by Passenger Class”)
plt.show()
sns.histplot(titanic[‘age’].dropna(),bins=30,kde=True) 
plt.title(“Age Distribution”)
plt.show()
sns.histplot(titanic[‘fare’],bins=30,kde=True)
plt.title(“Fare Distribution”)
plt.xlabel(“Fare”)
plt.ylabel(“Count”)
plt.show()
sns.boxplot(x=’surived’,y=’fare’,data=titanic)
plt.title(“Fare vs Surived”)
plt.show()
